// IB/08 glycocalyx in 3D: input file for IBAMR 0.16.0 or newer.
//
// One glycocalyx fiber, a cylinder of 13,600 target points, stands on the
// floor of a 1/8 by 1/8 by 1 box of fluid. The box is periodic in x and y.
// The lid (z = 0.5) slides in the x-direction and the floor (z = -0.5) is
// fixed, so the fluid is sheared past the fiber.
//
// This file must have Unix (LF) line endings. A file saved with Windows (CRLF)
// line endings stops with "Illegal character token in input". Older course
// versions ended every line with // to hide the extra character.

// physical parameters
L = 1.0                                   // length of the computational (fluid) domain (m)
RHO = 1000   //fluid mass density (kg/m^3)
V = 0.1                                   // speed of the lid (m/s)
GLYCO_H = 10.0/64.0                       // height of the glycocalyx fiber (m)
V_GLYCO = V*GLYCO_H/L                     // speed of the steady shear flow at the height of the fiber's top (m/s)

// Viscosity. The course version sets MU = 40, which makes the Reynolds number
// RHO*V_GLYCO*GLYCO_H/MU = 0.061. The 2014 version set MU from a Reynolds
// number instead (RE = 1, MU = 2.44). To do that, comment out the MU line and
// uncomment the two lines below it.
MU = 40                             // fluid dynamic viscosity (N s / m^2)
// RE = 1.0                                // Reynolds number based on the fiber's height
// MU = RHO*V_GLYCO*GLYCO_H/RE             // fluid dynamic viscosity (N s / m^2)

// How the flow starts.
//   0: the fluid starts at rest and the lid speeds up as V*tanh(2t), as in the
//      course version. The flow needs several seconds to reach the fiber.
//   1: the fluid starts as the steady shear flow u = V*(z + L/2)/L and the lid
//      moves at speed V from the start, so the flow passes the fiber at once.
SHEAR_START = 0

// Speed (m/s) at which the target points drag the fiber in the x-direction,
// as in the 2014 version. 0 keeps the fiber fixed (the course version).
TARGET_VELOCITY = 0.0

// grid spacing parameters
MAX_LEVELS = 3                            // maximum number of levels in locally refined grid
REF_RATIO  = 4                            // refinement ratio between levels
N = 32                                     // actual    number of grid cells on coarsest grid level (in z; x and y have N/8)
NFINEST = (REF_RATIO^(MAX_LEVELS - 1))*N  // effective number of grid cells on finest   grid level (in z)
DX = (1.0*L)/NFINEST                      // Cartesian mesh width (m)

// solver parameters
DELTA_FUNCTION      = "IB_4"
SOLVER_TYPE         = "STAGGERED"              // the fluid solver to use (STAGGERED or COLLOCATED)
START_TIME          = 0.0e0                    // initial simulation time
END_TIME            = 0.2                      // final simulation time (s); the course version used 10.0 (see the note below)
GROW_DT             = 2.0e0                    // growth factor for timesteps
NUM_CYCLES          = 1                        // number of cycles of fixed-point iteration
CONVECTIVE_TS_TYPE  = "ADAMS_BASHFORTH"        // convective time stepping type
CONVECTIVE_OP_TYPE  = "PPM"                    // convective differencing discretization type
CONVECTIVE_FORM     = "ADVECTIVE"              // how to compute the convective terms
NORMALIZE_PRESSURE  = TRUE                     // whether to explicitly force the pressure to have mean zero
CFL_MAX             = 0.3                      // maximum CFL number
DT                  = 1.0e-5                   // maximum timestep size
ERROR_ON_DT_CHANGE  = TRUE                     // whether to emit an error message if the time step size changes
VORTICITY_TAGGING   = TRUE                     // whether to tag cells for refinement based on vorticity thresholds
TAG_BUFFER          = 1                        // size of tag buffer used by grid generation algorithm
REGRID_CFL_INTERVAL = 0.5                      // regrid whenever any material point could have moved 0.5 meshwidths since previous regrid
OUTPUT_U            = TRUE
OUTPUT_P            = TRUE
OUTPUT_F            = FALSE
OUTPUT_OMEGA        = TRUE
OUTPUT_DIV_U        = TRUE
ENABLE_LOGGING      = TRUE

// output intervals, in time steps
VIZ_INTERVAL        = int(END_TIME/(20*DT))    // 20 VisIt frames per run
DATA_INTERVAL       = int(END_TIME/(50*DT))    // 50 X/F data files and integral{F} lines per run
RESTART_INTERVAL    = int(1.0/DT + 0.5)        // restart files every simulated second (and at the end of the run)
// (int() rounds down, and 1.0/DT is 99999.99999999999 in floating point, so
// the course version's int(1.0/DT) wrote restart files every 99,999 steps.)

// collocated solver parameters
PROJECTION_METHOD_TYPE = "PRESSURE_UPDATE"
SECOND_ORDER_PRESSURE_UPDATE = TRUE

// Initial velocity: zero, or the steady shear flow when SHEAR_START = 1.
// (X_2 is z. The constants SHEAR, V0 and L0 are copied from the top of this
// file because the expressions can use only constants defined in their block.)
VelocityInitialConditions {
   SHEAR = SHEAR_START
   V0 = V
   L0 = L
   function_0 = "SHEAR*V0*(X_2 + 0.5*L0)/L0"  // initial  conditions for the x-component of the velocity (course version: "0.0")
   function_1 = "0.0"                     // initial  conditions for the y-component of the velocity
   function_2 = "0.0"                     // initial  conditions for the z-component of the velocity
}

// Boundary conditions. The domain is periodic in x and y, so only the floor
// (side 4, z = -0.5) and the lid (side 5, z = 0.5) use these. Each side has
// a*u + b*(normal stress) = g; here a = 1 and b = 0, so g is the velocity.
// The lid's x-velocity ramps up smoothly to V: V*tanh(2t) is 96% of V by t = 1 s.
// (With SHEAR_START = 1 the lid moves at V from the start.)
// Everything else is zero: no slip on the floor and no flow through the lid.
VelocityBcCoefs_0 {                       // boundary conditions for the x-component of the velocity
   V_LID = V                              // speed of the lid, from the top of this file
   SHEAR = SHEAR_START

   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "1.0"
   acoef_function_5 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "0.0"
   bcoef_function_5 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
   gcoef_function_4 = "0.0"
   gcoef_function_5 = "V_LID*(SHEAR + (1 - SHEAR)*tanh(2*t))"   // course version: "0.1*tanh(2*t)"
}

VelocityBcCoefs_1 {                       // boundary conditions for the y-component of the velocity
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "1.0"
   acoef_function_5 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "0.0"
   bcoef_function_5 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
   gcoef_function_4 = "0.0"
   gcoef_function_5 = "0.0"
}

VelocityBcCoefs_2 {                       // boundary conditions for the z-component of the velocity
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "1.0"
   acoef_function_5 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "0.0"
   bcoef_function_5 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
   gcoef_function_4 = "0.0"
   gcoef_function_5 = "0.0"
}

IBHierarchyIntegrator {
   start_time          = START_TIME
   end_time            = END_TIME
   grow_dt             = GROW_DT
   regrid_cfl_interval = REGRID_CFL_INTERVAL
   dt_max              = DT
   error_on_dt_change  = ERROR_ON_DT_CHANGE
   enable_logging      = ENABLE_LOGGING
}

IBMethod {
   delta_fcn      = DELTA_FUNCTION
   enable_logging = ENABLE_LOGGING
}

IBStandardInitializer {
   max_levels = MAX_LEVELS
   structure_names = "glyco_512"          // reads glyco_512.vertex and glyco_512.target
   glyco_512 {
      level_number = MAX_LEVELS - 1       // put the structure on the finest grid level
   }
}

INSCollocatedHierarchyIntegrator {
   mu                            = MU
   rho                           = RHO
   start_time                    = START_TIME
   end_time                      = END_TIME
   grow_dt                       = GROW_DT
   convective_time_stepping_type = CONVECTIVE_TS_TYPE
   convective_op_type            = CONVECTIVE_OP_TYPE
   convective_difference_form    = CONVECTIVE_FORM
   normalize_pressure            = NORMALIZE_PRESSURE
   cfl                           = CFL_MAX
   dt_max                        = DT
   using_vorticity_tagging       = VORTICITY_TAGGING
   vorticity_abs_thresh          = 1.0, 2.0, 4.0, 8.0
   tag_buffer                    = TAG_BUFFER
   output_U                      = OUTPUT_U
   output_P                      = OUTPUT_P
   output_F                      = OUTPUT_F
   output_Omega                  = OUTPUT_OMEGA
   output_Div_U                  = OUTPUT_DIV_U
   enable_logging                = ENABLE_LOGGING
   projection_method_type        = PROJECTION_METHOD_TYPE
   use_2nd_order_pressure_update = SECOND_ORDER_PRESSURE_UPDATE
}

INSStaggeredHierarchyIntegrator {
   mu                            = MU
   rho                           = RHO
   start_time                    = START_TIME
   end_time                      = END_TIME
   grow_dt                       = GROW_DT
   convective_time_stepping_type = CONVECTIVE_TS_TYPE
   convective_op_type            = CONVECTIVE_OP_TYPE
   convective_difference_form    = CONVECTIVE_FORM
   normalize_pressure            = NORMALIZE_PRESSURE
   cfl                           = CFL_MAX
   dt_max                        = DT
   using_vorticity_tagging       = VORTICITY_TAGGING
   vorticity_abs_thresh          = 1.0, 2.0, 4.0, 8.0
   tag_buffer                    = TAG_BUFFER
   output_U                      = OUTPUT_U
   output_P                      = OUTPUT_P
   output_F                      = OUTPUT_F
   output_Omega                  = OUTPUT_OMEGA
   output_Div_U                  = OUTPUT_DIV_U
   enable_logging                = ENABLE_LOGGING
}

Main {
   solver_type = SOLVER_TYPE

// log file parameters
   log_file_name               = "IB3d.log"
   log_all_nodes               = FALSE

// visualization dump parameters
   viz_writer                  = "VisIt","Silo"
   viz_dump_interval           = VIZ_INTERVAL
   viz_dump_dirname            = "viz_IB3d"
   visit_number_procs_per_file = 1

// restart dump parameters
   restart_dump_interval       = RESTART_INTERVAL
   restart_dump_dirname        = "restart_IB3d"

// hierarchy data dump parameters (the X.* and F.* files written by output_data)
   data_dump_interval          = DATA_INTERVAL
   data_dump_dirname           = "hier_data_IB3d"

// timer dump parameters
   timer_dump_interval         = 0
}

// The domain is 1/8 by 1/8 by 1: 4 by 4 by 32 cells on the coarsest level and
// 64 by 64 by 512 on the finest, so the cells are cubes of side DX.
CartesianGeometry {
   domain_boxes = [ (0,0,0) , (N/8 - 1,N/8 - 1,N - 1) ]
   x_lo = -L/16, -L/16, -L/2   // lower end of computational domain.
   x_up =  L/16,  L/16, L/2  // upper end of computational domain.
   periodic_dimension = 1, 1, 0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO,REF_RATIO
      level_2 = REF_RATIO,REF_RATIO,REF_RATIO
      level_3 = REF_RATIO,REF_RATIO,REF_RATIO
      level_4 = REF_RATIO,REF_RATIO,REF_RATIO
      level_5 = REF_RATIO,REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = NFINEST/8, NFINEST/8, NFINEST/8  // all finer levels will use same values as level_0
   }
   smallest_patch_size {
      level_0 =   4, 4, 4  // all finer levels will use same values as level_0
   }
   efficiency_tolerance = 0.85e0  // min % of tag cells in new patch level
   combine_efficiency   = 0.85e0  // chop box if sum of volumes of smaller boxes < efficiency * vol of large box
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}

TimerManager{
   print_exclusive = FALSE
   print_total     = TRUE
   print_threshold = 0.1
   timer_list      = "IBAMR::*::*","IBTK::*::*","*::*::*"
}
