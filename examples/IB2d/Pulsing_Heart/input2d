%*****%***%***%***%***%***% INPUT2d FILE: %***%***%***%***%***%*****%
% Pulsing_Heart (pyIB2d), chapter 4c: a cartoon heart whose target points interpolate between two phases;
% the 32 x 32 MATLAB example's parameters, trailing semicolons removed for the Python parser.

%
% FLUID PARAMETER VALUES %
%
Fluid_Parameters {
mu = 0.5                % Dynamic Viscosity (N*s/m^2)
rho = 1                 % Density (kg/m^3)
}

%
% TEMPORAL INFORMATION %
%
Temporal_Information {
Tfinal = 0.1            % Final time of simulation (s): two beats of 0.05
dt = 1.0e-5             % Time-step (s)
}

%
% GRID PARAMETERS %
%
Grid_Parameters {
Nx =  32                % # of Eulerian Grid Pts. in x-Direction (MUST BE EVEN!!!)
Ny =  32                % # of Eulerian Grid Pts. in y-Direction (MUST BE EVEN!!!)
Lx = 1.0                % Length of Eulerian Grid in x-Direction (m)
Ly = 1.0                % Length of Eulerian Grid in y-Direction (m)
supp = 4                % Choose dirac-delta support (KEEP IT EVEN!!!)
}

%
% LAGRANGIAN STRUCTURE MODEL INFORMATION %
%
Lag_Structure_Info {
springs = 0             % 0 (for no) or 1 (for yes)
update_springs = 0      % 0 (for no) or 1 (for yes)
target_pts = 1          % 0 (for no) or 1 (for yes)
update_target = 1       % 0 (for no) or 1 (for yes): update_Target_Point_Positions.py blends the two phases
beams = 0               % 0 (for no) or 1 (for yes)
update_beams = 0        % 0 (for no) or 1 (for yes)
nonInvariant_beams = 0  % 0 (for no) or 1 (for yes)
update_nonInv_beams = 0 % 0 (for no) or 1 (for yes)
FV_LT_muscle = 0        % 0 (for no) or 1 (for yes)
3_element_muscle = 0    % 0 (for no) or 1 (for yes)
arb_ext_force = 0       % 0 (for no) or 1 (for yes)
tracers = 0             % 0 (for no) or 1 (for yes)
mass_pts = 0            % 0 (for no) or 1 (for yes)
gravity = 0             % 0 (for no) or 1 (for yes)
x_gravity_vec_comp = 0  % x-Component of Gravity Vector
y_gravity_vec_comp = -1 % y-Component of Gravity Vector
porous_media = 0        % 0 (for no) or 1 (for yes)
concentration = 0       % 0 (for no) or 1 (for yes)
electro_phys = 0        % 0 (for no) or 1 (for yes)
damped_springs = 0      % 0 (for no) or 1 (for yes)
update_damp_springs = 0 % 0 (for no) or 1 (for yes)
boussinesq = 0          % 0 (for no) or 1 (for yes)
expansion_coeff = 1.0   % expansion coefficient for Boussinesq approx.
user_force_model = 0    % 0 (for no) or 1 (for yes)
}

%
% PRINTING INFORMATION
%
Output_Info {
print_dump = 50          % How often to print (PLOT) to screen: 200 dumps over two beats
save_Vorticity = 1       % Save Vorticity Scalar Data to .vtk format
save_Pressure = 1        % Save Pressure Scalar Data to .vtk format
save_uVec = 1            % Save u-Vector Data to .vtk format
save_uMag = 1            % Save uMagnitude Scalar Data to .vtk format
save_uX = 0              % Save uX Scalar Data to .vtk format
save_uY = 0              % Save uY Scalar Data to .vtk format
save_fMag = 0            % Save Force Magnitude Scalar Data to .vtk format
save_fX = 0              % Save x-Force Component Scalar Data to .vtk format
save_fY = 0              % Save y-Force Component Scalar Data to .vtk format
save_hier = 1            % Save Scalar Force Data on Lag. Structure to .vtk format
plot_Matlab = 0          % Plot using MatPlotlib? (1=YES, 0=NO)
plot_LagPts = 0          % Plot Lagrangian Points ONLY
plot_Velocity = 0        % Plot Lagrangian Points + VELOCITY FIELD
plot_Vorticity = 0       % Plot Lagrangian Points + VORTICITY colormap
plot_MagVelocity = 0     % Plot Lagrangian Points + MAGNITUDE OF VELOCITY colormap
plot_Pressure = 0        % Plot Lagrangian Points + PRESSURE colormap
}

%
% LAGRANGIAN STRUCTURE NAME %
%
Lag_Name {
string_name = "heart"    % String name for simulation
}
