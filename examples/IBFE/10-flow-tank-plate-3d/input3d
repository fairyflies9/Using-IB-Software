// IBFE/10 flow tank with a plate in 3D: input file for IBAMR 0.16.0 or newer.
//
// A thin elastic plate (0.125 by 2 by 2, 11,481 tetrahedra) stands across the
// flow in a 32 by 16 by 16 tank. A band across the middle of the plate is
// tethered; the rest of the plate bends with the flow. The flow speeds up from
// rest to 0.1 in the x-direction.
//
// This file must have Unix (LF) line endings. A file saved with Windows (CRLF)
// line endings stops with "Illegal character token in input". Older course
// versions ended every line with // to hide the extra character.

// physical parameters
// MU = 1/Re makes Re the Reynolds number for a speed of 1 and a length of 1.
// The flow here moves at U_FLOW = 0.1 and the plate is 2 wide, so the
// Reynolds number of the plate is RHO*U_FLOW*2/MU = 20.
Re = 100.0
MU = 1.0/Re
RHO = 1.0
U_FLOW = 0.1                                   // flow speed far from the plate (the course version wrote 0.1 into each boundary condition)

// grid spacing parameters
L = 16.0                                       // width of computational domain
MAX_LEVELS = 3                                 // maximum number of levels in locally refined grid
REF_RATIO  = 4                                 // refinement ratio between levels
N = 16                                         // actual    number of grid cells on coarsest grid level
NFINEST = (REF_RATIO^(MAX_LEVELS - 1))*N       // effective number of grid cells on finest   grid level
DX0 = L/N                                      // mesh width on coarsest grid level
DX  = L/NFINEST                                // mesh width on finest   grid level
// MFAC is used by examples that build their mesh in the program (for example
// IBAMR's IBFE/explicit/ex2). It has no effect on a mesh read from a file,
// like this one: plate2.msh was made with elements about DX across.
MFAC = 3.0                                     // ratio of Lagrangian mesh width to Cartesian mesh width
PK1_DEV_QUAD_ORDER = "SEVENTH"                 // quadrature order for the deviatoric stress
PK1_DIL_QUAD_ORDER = "FIFTH"                   // quadrature order for the dilational stress

// the plate
MESH_FILENAME = "plate2.msh"                   // gmsh mesh of the plate (MSH 2.2 ASCII)
KAPPA_S = 1e5                                  // stiffness of the tether force
TETHER_HALF_WIDTH = 0.1                        // the band |z| < 0.1 (in the mesh file's coordinates) is tethered
TRANSLATE_X = 0.0                              // move the plate and its tether along x at the start
// The 2017 version's tank ran from x = -16 to 16, and TRANSLATE_X = -7 put the
// plate 9 units from the inflow side. This tank runs from x = -8 to 24, so the
// plate starts 8 units from the inflow side without being moved.

// Plate material: a compressible neo-Hookean solid with shear modulus MU_*
// and first Lame parameter BETA_*, made from Young's modulus E_* and Poisson
// ratio NU. With TWO_MATERIALS = FALSE (the course version) the whole plate
// uses the stem values. With TRUE, the band |z| < STEM_HALF_WIDTH is stem and
// the rest is leaf, as in the 2017 version.
TWO_MATERIALS = FALSE
STEM_HALF_WIDTH = 0.25
NU=0.3                                         // Poisson ratio
E_STEM=0.7                                     // Young's modulus of the stem
E_LEAF=1.4                                     // Young's modulus of the leaf
// NOTE: as in the course version, each MU line uses the other material's E
// (MU_STEM uses E_LEAF), while each BETA line uses its own. The values in the
// comments are what the plate gets. See README.md.
MU_LEAF = E_STEM/(2.0*(1.0+NU))                // shear modulus of the leaf: 0.269
MU_STEM = E_LEAF/(2.0*(1.0+NU))                // shear modulus of the stem: 0.538
BETA_STEM = (E_STEM*NU) / ((1.0 + NU)*(1.0 - 2.0*NU))  // first Lame parameter of the stem: 0.404
BETA_LEAF = E_LEAF*NU/((1.0 + NU)*(1.0 - 2.0*NU))      // first Lame parameter of the leaf: 0.808

// solver parameters
IB_DELTA_FUNCTION          = "IB_4"            // the type of smoothed delta function to use for Lagrangian-Eulerian interaction
SPLIT_FORCES               = FALSE             // whether to split interior and boundary forces
USE_JUMP_CONDITIONS        = FALSE             // whether to impose pressure jumps at fluid-structure interfaces
USE_CONSISTENT_MASS_MATRIX = TRUE              // whether to use a consistent or lumped mass matrix
IB_POINT_DENSITY           = 1.0               // approximate density of IB quadrature points for Lagrangian-Eulerian interaction
SOLVER_TYPE                = "STAGGERED"       // the fluid solver to use (STAGGERED or COLLOCATED)
START_TIME                 = 0.0e0             // initial simulation time
END_TIME                   = 0.5               // final simulation time; the course version used 2.0 (see README.md)
GROW_DT                    = 2.0e0             // growth factor for timesteps
CONVECTIVE_TS_TYPE         = "ADAMS_BASHFORTH" // convective time stepping type
CONVECTIVE_OP_TYPE         = "PPM"             // convective differencing discretization type
CONVECTIVE_FORM            = "ADVECTIVE"       // how to compute the convective terms
NORMALIZE_PRESSURE         = FALSE             // whether to explicitly force the pressure to have mean zero
CFL_MAX                    = 0.2               // maximum CFL number
DT                         = 1e-4              // maximum timestep size
ERROR_ON_DT_CHANGE         = TRUE              // whether to emit an error message if the time step size changes
VORTICITY_TAGGING          = TRUE              // whether to tag cells for refinement based on vorticity thresholds
TAG_BUFFER                 = 1                 // size of tag buffer used by grid generation algorithm
REGRID_CFL_INTERVAL        = 0.5               // regrid whenever any material point could have moved 0.5 meshwidths since previous regrid
OUTPUT_U                   = TRUE
OUTPUT_P                   = TRUE
OUTPUT_F                   = TRUE
OUTPUT_OMEGA               = TRUE
OUTPUT_DIV_U               = TRUE
ENABLE_LOGGING             = TRUE

// output intervals, in time steps
VIZ_INTERVAL               = int(END_TIME/(20*DT))   // 20 VisIt and ExodusII frames per run (the course version: every 0.1 s)
DATA_INTERVAL              = int(END_TIME/(100*DT))  // 100 tether-force lines per run (the course version called an empty output_data every step)
RESTART_INTERVAL           = int(0.5/DT + 0.5)       // restart files every 0.5 time units and at the end of the run (the course version wrote none)

// model parameters
// The tether stiffness KAPPA_S is set above. IBAMR's examples often scale it
// with the grid and time step instead, for example
//KAPPA_S = 7.5*DX/DT^2
// ETA_S is a damping coefficient for the tether in some IBAMR examples. This
// program does not use it.
ETA_S = 0*DX/DT

// collocated solver parameters
PROJECTION_METHOD_TYPE = "PRESSURE_UPDATE"
SECOND_ORDER_PRESSURE_UPDATE = TRUE

// Boundary conditions. The tank is not periodic. On all six sides the
// x-velocity is U_FLOW*tanh(2t), which is 96% of U_FLOW by t = 1, and the
// other velocity components are zero: a uniform stream that starts from rest.
// Each side has a*u + b*(normal stress) = g; here a = 1 and b = 0, so g is
// the velocity.
VelocityBcCoefs_0 {                       // boundary conditions for the x-component of the velocity
   U0 = U_FLOW                            // copied here because the expressions can use only constants defined in their block

   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "1.0"
   acoef_function_5 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "0.0"
   bcoef_function_5 = "0.0"

   gcoef_function_0 = "U0*tanh(2*t)"
   gcoef_function_1 = "U0*tanh(2*t)"
   gcoef_function_2 = "U0*tanh(2*t)"
   gcoef_function_3 = "U0*tanh(2*t)"
   gcoef_function_4 = "U0*tanh(2*t)"
   gcoef_function_5 = "U0*tanh(2*t)"
}

VelocityBcCoefs_1 {                       // boundary conditions for the y-component of the velocity
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "1.0"
   acoef_function_5 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "0.0"
   bcoef_function_5 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
   gcoef_function_4 = "0.0"
   gcoef_function_5 = "0.0"
}

VelocityBcCoefs_2 {                       // boundary conditions for the z-component of the velocity
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "1.0"
   acoef_function_5 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "0.0"
   bcoef_function_5 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
   gcoef_function_4 = "0.0"
   gcoef_function_5 = "0.0"
}

IBHierarchyIntegrator {
   start_time          = START_TIME
   end_time            = END_TIME
   grow_dt             = GROW_DT
   regrid_cfl_interval = REGRID_CFL_INTERVAL
   dt_max              = DT
   error_on_dt_change  = ERROR_ON_DT_CHANGE
   enable_logging      = ENABLE_LOGGING
}

IBFEMethod {
   IB_delta_fcn               = IB_DELTA_FUNCTION
   split_forces               = SPLIT_FORCES
   use_jump_conditions        = USE_JUMP_CONDITIONS
   use_consistent_mass_matrix = USE_CONSISTENT_MASS_MATRIX
   IB_point_density           = IB_POINT_DENSITY
   IB_quad_type               = "QGRID"   // or "QGAUSS"
}

INSCollocatedHierarchyIntegrator {
   mu                            = MU
   rho                           = RHO
   start_time                    = START_TIME
   end_time                      = END_TIME
   grow_dt                       = GROW_DT
   convective_time_stepping_type = CONVECTIVE_TS_TYPE
   convective_op_type            = CONVECTIVE_OP_TYPE
   convective_difference_form    = CONVECTIVE_FORM
   normalize_pressure            = NORMALIZE_PRESSURE
   cfl                           = CFL_MAX
   dt_max                        = DT
   using_vorticity_tagging       = VORTICITY_TAGGING
   vorticity_abs_thresh          = 0.125,0.25,.5,1, 2
   tag_buffer                    = TAG_BUFFER
   output_U                      = OUTPUT_U
   output_P                      = OUTPUT_P
   output_F                      = OUTPUT_F
   output_Omega                  = OUTPUT_OMEGA
   output_Div_U                  = OUTPUT_DIV_U
   enable_logging                = ENABLE_LOGGING
   projection_method_type        = PROJECTION_METHOD_TYPE
   use_2nd_order_pressure_update = SECOND_ORDER_PRESSURE_UPDATE
}

INSStaggeredHierarchyIntegrator {
   mu                            = MU
   rho                           = RHO
   start_time                    = START_TIME
   end_time                      = END_TIME
   grow_dt                       = GROW_DT
   convective_time_stepping_type = CONVECTIVE_TS_TYPE
   convective_op_type            = CONVECTIVE_OP_TYPE
   convective_difference_form    = CONVECTIVE_FORM
   normalize_pressure            = NORMALIZE_PRESSURE
   cfl                           = CFL_MAX
   dt_max                        = DT
   using_vorticity_tagging       = VORTICITY_TAGGING
   vorticity_abs_thresh          = 0.125,0.25,.5,1, 2
   tag_buffer                    = TAG_BUFFER
   output_U                      = OUTPUT_U
   output_P                      = OUTPUT_P
   output_F                      = OUTPUT_F
   output_Omega                  = OUTPUT_OMEGA
   output_Div_U                  = OUTPUT_DIV_U
   enable_logging                = ENABLE_LOGGING
}

Main {
   solver_type = SOLVER_TYPE

// log file parameters
   log_file_name               = "IB3d.log"
   log_all_nodes               = FALSE

// visualization dump parameters: VisIt files for the fluid, ExodusII for the plate
   viz_writer                  = "VisIt","ExodusII"
   viz_dump_interval           = VIZ_INTERVAL
   viz_dump_dirname            = "viz_IB3d"
   visit_number_procs_per_file = 1

// restart dump parameters
   restart_dump_interval       = RESTART_INTERVAL
   restart_dump_dirname        = "restart_IB3d"

// hierarchy data dump parameters (output_data: the tether force, written to hier_data_IB3d/tether_force.txt)
   data_dump_interval          = DATA_INTERVAL
   data_dump_dirname           = "hier_data_IB3d"

// timer dump parameters
   timer_dump_interval         = 0
}

// The tank runs from x = -8 to 24 and from -8 to 8 in y and z: 32 by 16 by 16
// cells on the coarsest level (DX0 = 1) and DX = 1/16 on the finest level.
// The plate starts at 0 < x < 0.125, -1 < y < 1, -1 < z < 1.
CartesianGeometry {
   domain_boxes = [ (0,0,0),(2*N - 1,N - 1,N - 1) ]
   x_lo = -0.5*L,-0.5*L,-0.5*L
   x_up =  1.5*L, 0.5*L, 0.5*L
   periodic_dimension = 0,0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO,REF_RATIO
      level_2 = REF_RATIO,REF_RATIO,REF_RATIO
      level_3 = REF_RATIO,REF_RATIO,REF_RATIO
      level_4 = REF_RATIO,REF_RATIO,REF_RATIO
      level_5 = REF_RATIO,REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 256,256,256  // all finer levels will use same values as level_0
   }
   smallest_patch_size {
      level_0 =   8,  8,  8  // all finer levels will use same values as level_0
   }
   efficiency_tolerance = 0.80e0  // min % of tag cells in new patch level
   combine_efficiency   = 0.80e0  // chop box if sum of volumes of smaller boxes < efficiency * vol of large box
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}

TimerManager{
   print_exclusive = FALSE
   print_total = TRUE
   print_threshold = 0.1
   timer_list = "IBAMR::*::*","IBTK::*::*","*::*::*"
}
